# Copy to .env and change the secrets for production.
FLASK_ENV=development
# Strong random secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-dev-jwt-secret
# SQLite database (file created automatically)
DATABASE_URL=sqlite:///rlm.db
# Frontend origin allowed for CORS (must match where Next.js runs)
FRONTEND_ORIGIN=http://localhost:3000
# Cookie security: set to true only when serving over HTTPS
COOKIE_SECURE=false
# Replay video uploads: storage folder and max size (MB)
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=200
# Default admin (Zoli) credentials used by the seed script — change these locally
ADMIN_EMAIL=zoli@rlm.hu
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=JusTZoly
# Email — HTML letters. Leave MAIL_HOST empty in development: the letter is
# saved under backend/mail_outbox (not returned by the API).
# Gmail: 2FA + App Password, then set MAIL_HOST.
# Gmail example: enable 2FA, create an App Password, then:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM=you@gmail.com
# Discord OAuth — leave empty to keep the manual Discord username field.
# Create an app at https://discord.com/developers/applications
# Redirect: http://127.0.0.1:5001/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:5001/api/auth/discord/callback
