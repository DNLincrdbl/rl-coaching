# Copy to .env and change the secrets for production.
FLASK_ENV=development
# Strong random secrets (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-dev-secret
JWT_SECRET_KEY=change-me-dev-jwt-secret
# SQLite database (file created automatically)
DATABASE_URL=sqlite:///rlm.db
# Frontend origin allowed for CORS (must match where Next.js runs)
FRONTEND_ORIGIN=http://localhost:3000
# Cookie security: set to true only when serving over HTTPS
COOKIE_SECURE=false
# Replay video uploads: storage folder and max size (MB)
UPLOAD_FOLDER=uploads
MAX_UPLOAD_MB=200
# Default admin (Zoli) credentials used by the seed script — change these locally
ADMIN_EMAIL=zoli@rlm.hu
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=JusTZoly
